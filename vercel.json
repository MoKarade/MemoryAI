{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node .github/ci/ignore-command.mjs",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "*": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/apprentissage",
      "schedule": "7 9 * * *"
    },
    {
      "path": "/api/cron/reseau",
      "schedule": "27 10 * * *"
    }
  ]
}
