# .env.example — à copier en .env.local (JAMAIS committé) et dans les variables du projet
# Vercel `memory-ai`. Aucune valeur réelle ici. Comment obtenir chacune : HANDOVER.md.

# ── Authentification : la session vient du HUB ──────────────────────────────
# MemoryAI n'a AUCUN fournisseur (providers: []). Elle déchiffre le cookie posé par
# hubperso.com sur `.hubperso.com`. Il faut donc :
#   AUTH_SECRET        — la MÊME valeur que le projet Vercel `hubperso`. Différente ⇒ le
#                        cookie arrive mais ne se lit pas ⇒ boucle sur /login SANS erreur.
#   AUTHORIZED_EMAIL   — le PROPRIÉTAIRE, et ici la SEULE adresse admise : cette app n'a pas
#                        d'invités (ADR 0001 §3). Comparée en minuscules, sans réseau.
#   AUTH_COOKIE_DOMAIN — `.hubperso.com` en PRODUCTION SEULEMENT (rejeté silencieusement
#                        sur localhost et *.vercel.app).
# Sans AUTH_SECRET et AUTHORIZED_EMAIL, le middleware refuse TOUT (503) : échec fermé.
AUTH_SECRET=
AUTHORIZED_EMAIL=
# AUTH_COOKIE_DOMAIN=.hubperso.com

# ── Session signée (phase 1, plan auth-asym-hubperso) ────────────────────────
# JWKS (JSON) des clés PUBLIQUES publiées par Hubperso pour vérifier son nouveau cookie
# signé ES256 `__Secure-hub.session` (lib/sessionAsymetrique.ts). Lu par le middleware ET
# par `requireSession()`. JAMAIS une clé privée ici — MemoryAI ne fait que lire. Absente →
# aucun effet : l'app retombe sur l'ancien cookie (Auth.js/JWE) comme aujourd'hui, et
# Hubperso n'émet pas encore le nouveau (phase 2).
# Forme attendue : {"keys":[{"kty":"EC","crv":"P-256","x":"...","y":"...","kid":"..."}]}
HUB_SESSION_PUBLIC_KEYS=

# URL du hub : lien « Aller au hub » et cible de la redirection de connexion.
# NEXT_PUBLIC_HUB_URL=https://hubperso.com

# ── Intégration hub ─────────────────────────────────────────────────────────
# Le hub l'envoie dans x-hub-token pour lire GET /hub/summary. Absent → 503 (intégration
# désactivée) ; invalide → 401. La MÊME valeur va dans HUB_TOKEN_MEMORYAI côté Hubperso.
# Un seul sens ici : MemoryAI n'appelle jamais POST /api/acces (pas d'invités).
HUB_TOKEN=

# ── Kill-switches (ADR 0001 §3) ─────────────────────────────────────────────
# MEMORYAI_GEL=1 ⇒ 503 sur le MCP, /api/faits, /api/contexte et le chat. L'UI reste lisible.
# Seule la valeur « 1 » gèle.
# MEMORYAI_GEL=

# ── Base et chiffrement (lot 2) ─────────────────────────────────────────────
# DATABASE_URL           — Neon, projet NEUF (jamais celui du hub).
# MEMORYAI_CHIFFREMENT   — clé AES-256-GCM des faits N1+ : openssl rand -base64 32
#                          La retirer = 503 fermé, rien de lisible.
# MEMORYAI_JOURNAL_CLE   — HMAC du journal d'accès, DISTINCTE de la précédente.
DATABASE_URL=
MEMORYAI_CHIFFREMENT=
MEMORYAI_JOURNAL_CLE=

# ── Serveur MCP (lot 4) ─────────────────────────────────────────────────────
# MCP_SIGNING_KEY — signe les jetons OAuth (≥ 32 caractères) ; la faire tourner = kill-switch.
# MCP_ACCESS_KEY  — la clé que Marc saisit UNE fois dans claude.ai (≥ 16 caractères).
MCP_SIGNING_KEY=
MCP_ACCESS_KEY=

# ── Chat (lot 5) ────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY — clé DÉDIÉE à MemoryAI (le coût publié au hub est celui de cette app).
# MEMORYAI_N2_CHAT  — « 1 » autorise le chat à servir des faits de niveau 2. À poser
#                     SEULEMENT après avoir lu la rétention dans console.anthropic.com.
ANTHROPIC_API_KEY=
# MEMORYAI_N2_CHAT=

# ── Écrivains — un jeton par app, un rôle, un périmètre (ADR 0001 §3, lot 3) ──
# Le NOM de la variable dit l'app et le rôle : MEMORYAI_TOKEN_<APP>_<ECRITURE|LECTURE>.
# ≥ 16 caractères (openssl rand -base64 24). Jeton inconnu ⇒ 401 muet. Une ligne
# `perimetres` au rôle `lecture` retire l'écriture sans toucher ici.
# MEMORYAI_TOKEN_DRIVEAI_ECRITURE=
# MEMORYAI_TOKEN_SEED_ECRITURE=

# ── Suivi des erreurs (Sentry, tâche #127) ──────────────────────────────────
# Un DSN n'est pas un secret fort, mais ne le publie pas non plus. Absent ou vide : Sentry reste
# éteint, rien ne part et l'app se construit sans erreur. SERVEUR seulement, et le texte des
# messages d'erreur est retiré avant l'envoi (lib/sentryConfig.ts, verrou tests/sentryConfig.test.ts).
# SENTRY_DSN=
